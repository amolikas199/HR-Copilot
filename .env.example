# Copy this file to ".env" and paste your real keys after the = sign.
# The .env file is where we keep secrets. It should NEVER be shared or committed to git.

# Groq API (for LLM)
GROQ_API_KEY=your_groq_api_key_here

# MongoDB (for persistence)
# Get your MongoDB Atlas connection string from https://www.mongodb.com/cloud/atlas
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/hr_copilot?retryWrites=true&w=majority
