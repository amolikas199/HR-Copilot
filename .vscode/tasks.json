{
  // Lets you start the app from inside VS Code with Ctrl+Shift+B
  // (Terminal -> Run Build Task). Runs in VS Code's own terminal panel.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run HR Copilot",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/streamlit.exe",
      "args": ["run", "app.py"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": { "PYTHONUTF8": "1" }
      },
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true }
    }
  ]
}
